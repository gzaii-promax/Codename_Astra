; Godot project configuration. Editable three-room map sample.
config_version=5

[application]
config/name="Ember Trial — Prototype 01"
run/main_scene="res://world/map_world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Localization="*res://localization/localization_service.gd"

[internationalization]
locale/fallback="zh_CN"
locale/include_text_server_data=true

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.075, 0.09, 0.12, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Damage receiver"
2d_physics/layer_4="Projectile"
